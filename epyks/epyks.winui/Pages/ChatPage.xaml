<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="epyks_winui.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:epyks_winui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{StaticResource EpyksBgBrush}">

    <Page.Resources>
        <!-- Server icon button style -->
        <Style x:Key="ServerIconStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="#36393F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource EpyksTextPrimaryBrush}"/>
        </Style>

        <!-- Channel item style -->
        <Style x:Key="ChannelItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <!-- Message list item style — no selection highlight -->
        <Style x:Key="MsgItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Col 0: Server Rail (72px) -->
            <ColumnDefinition Width="72"/>
            <!-- Col 1: Channel Sidebar (240px) -->
            <ColumnDefinition Width="240"/>
            <!-- Col 2: Chat Area -->
            <ColumnDefinition Width="*"/>
            <!-- Col 3: Member List (220px, hidden by default) -->
            <ColumnDefinition x:Name="MemberCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================
             COL 0 — SERVER RAIL
             ==================================================== -->
        <Grid Grid.Column="0" Background="{StaticResource EpyksServerRailBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Home button -->
            <Button x:Name="HomeBtn"
                    Grid.Row="0"
                    Style="{StaticResource ServerIconStyle}"
                    Margin="12,12,12,0"
                    ToolTipService.ToolTip="Home"
                    Click="HomeBtn_Click">
                <TextBlock Text="HM" FontSize="13" FontWeight="Bold"/>
            </Button>

            <!-- Separator -->
            <Border Grid.Row="0" Height="2" CornerRadius="1"
                    Background="{StaticResource EpyksDividerBrush}"
                    Margin="18,68,18,0"/>

            <!-- Server list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="ServerRailPanel" Spacing="6" Padding="12,8"/>
            </ScrollViewer>

            <!-- Add Server + Browse buttons at bottom -->
            <StackPanel Grid.Row="2" Spacing="6" Padding="12,8,12,16">
                <Button x:Name="CreateServerBtn"
                        Style="{StaticResource ServerIconStyle}"
                        Background="#23A55A"
                        ToolTipService.ToolTip="Create a Server"
                        Click="CreateServerBtn_Click">
                    <TextBlock Text="+" FontSize="22" FontWeight="Light"/>
                </Button>
                <Button x:Name="BrowseServersBtn"
                        Style="{StaticResource ServerIconStyle}"
                        ToolTipService.ToolTip="Browse Servers"
                        Click="BrowseServersBtn_Click">
                    <FontIcon Glyph="&#xE721;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ====================================================
             COL 1 — CHANNEL SIDEBAR
             ==================================================== -->
        <Grid Grid.Column="1" Background="{StaticResource EpyksSidebarBrush}">
            <Grid.RowDefinitions>
                <!-- Server name header -->
                <RowDefinition Height="48"/>
                <!-- Channel list -->
                <RowDefinition Height="*"/>
                <!-- Voice bar (hidden when not in voice) -->
                <RowDefinition Height="Auto"/>
                <!-- My account bar -->
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Server name / DM header -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource EpyksDividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Padding="12,0">
                    <TextBlock x:Name="SidebarTitle"
                               Text="Direct Messages"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{StaticResource EpyksTextHeaderBrush}"
                               VerticalAlignment="Center"/>
                    <!-- Server settings gear (visible in server mode) -->
                    <Button x:Name="ServerSettingsBtn"
                            Content="..."
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Foreground="{StaticResource EpyksTextMutedBrush}"
                            Click="ServerSettingsBtn_Click"/>
                </Grid>
            </Border>

            <!-- Channel / DM list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="ChannelPanel" Padding="8,8,8,0" Spacing="2"/>
            </ScrollViewer>


            <!-- My Account Bar -->
            <Border Grid.Row="3"
                    Background="{StaticResource EpyksMemberBarBrush}"
                    Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar + username -->
                    <Button Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Padding="0"
                            Click="MyProfileBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="MyAvatarEllipse" Width="32" Height="32">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#5865F2"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="MyUsernameText"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource EpyksTextHeaderBrush}"/>
                                <TextBlock Text="Online"
                                           FontSize="11"
                                           Foreground="#23A55A"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <!-- Mute -->
                        <Button x:Name="MuteBtn"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                ToolTipService.ToolTip="Toggle Mute"
                                Click="MuteBtn_Click">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="16" Foreground="{StaticResource EpyksTextMutedBrush}"/>
                        </Button>
                        <!-- Deafen -->
                        <Button x:Name="DeafenBtn"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                ToolTipService.ToolTip="Toggle Deafen"
                                Click="DeafenBtn_Click">
                            <FontIcon x:Name="DeafenIcon" Glyph="&#xE7F6;" FontSize="16" Foreground="{StaticResource EpyksTextMutedBrush}"/>
                        </Button>
                        <!-- Disconnect (only in voice) -->
                        <Button x:Name="AccountBarDisconnectBtn"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Disconnect"
                                Click="VoiceDisconnectBtn_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="#F23F43"/>
                        </Button>
                        <!-- Settings button -->
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                ToolTipService.ToolTip="Settings"
                                Click="SettingsBtn_Click">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource EpyksTextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ====================================================
             COL 2 — MAIN CHAT AREA
             ==================================================== -->
        <Grid Grid.Column="2" Background="{StaticResource EpyksChatBrush}">
            <Grid.RowDefinitions>
                <!-- Channel header -->
                <RowDefinition Height="48"/>
                <!-- Messages -->
                <RowDefinition Height="*"/>
                <!-- Reply preview -->
                <RowDefinition Height="Auto"/>
                <!-- Input bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Channel header -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource EpyksDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Channel name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelPrefixText"
                                   Text="#"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource EpyksTextMutedBrush}"/>
                        <TextBlock x:Name="ChannelHeaderText"
                                   Text="general"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource EpyksTextHeaderBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right toolbar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="MemberListToggle"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="18"
                                Foreground="{StaticResource EpyksTextMutedBrush}"
                                ToolTipService.ToolTip="Toggle Member List"
                                Click="MemberListToggle_Click">
                            <FontIcon Glyph="&#xE716;" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Voice Screen (Visible when viewing active voice channel) -->
            <Grid x:Name="VoiceScreenPanel" Grid.Row="1" Visibility="Collapsed" Background="Transparent" Padding="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0">
                    <ItemsControl x:Name="VoiceParticipantsGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemHeight="240" ItemWidth="240"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,24,0,0">
                    <Button x:Name="VoiceScreenMuteBtn" 
                            Background="#35373C" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="16,12"
                            Click="MuteBtn_Click">
                        <FontIcon x:Name="VoiceScreenMuteIcon" Glyph="&#xE720;" FontSize="16"/>
                    </Button>
                    <Button x:Name="VoiceScreenDeafenBtn" 
                            Background="#35373C" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="16,12"
                            Click="DeafenBtn_Click">
                        <FontIcon x:Name="VoiceScreenDeafenIcon" Glyph="&#xE7F6;" FontSize="16"/>
                    </Button>
                    <Button Background="#F23F43"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="24,12"
                            Click="VoiceDisconnectBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="16"/>
                            <TextBlock Text="Disconnect" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Message list -->
            <ListView x:Name="MessageList"
                      Grid.Row="1"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Background="Transparent"
                      Padding="0,8,0,4"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty chat placeholder -->
            <StackPanel x:Name="EmptyChatPlaceholder"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Opacity="0.4">
                <FontIcon Glyph="&#xE8BD;" FontSize="48"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource EpyksTextMutedBrush}"/>
                <TextBlock x:Name="EmptyChatText"
                           Text="No messages yet. Say hi!"
                           FontSize="16"
                           Foreground="{StaticResource EpyksTextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Reply preview bar -->
            <Border x:Name="ReplyPreviewBar"
                    Grid.Row="2"
                    Background="#383A40"
                    Padding="16,6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{StaticResource EpyksAccentBrush}"/>
                        <TextBlock x:Name="ReplyingToText"
                                   FontSize="13"
                                   Foreground="{StaticResource EpyksTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Foreground="{StaticResource EpyksTextMutedBrush}"
                            Click="CancelReplyBtn_Click">
                        <FontIcon Glyph="&#xE8BB;" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Message Input Bar -->
            <Border x:Name="MessageInputPanel"
                    Grid.Row="3"
                    Background="{StaticResource EpyksInputBrush}"
                    CornerRadius="8"
                    Margin="16,0,16,16"
                    Padding="4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Attach file -->
                    <Button Grid.Column="0"
                            Content="+"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="22"
                            FontWeight="Light"
                            Foreground="{StaticResource EpyksTextMutedBrush}"
                            ToolTipService.ToolTip="Upload File"
                            Click="AttachBtn_Click"/>

                    <!-- Text input -->
                    <TextBox x:Name="MessageInput"
                             Grid.Column="1"
                             PlaceholderText="Message..."
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource EpyksTextPrimaryBrush}"
                             FontSize="14"
                             Padding="4,12"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             AcceptsReturn="False"
                             KeyDown="MessageInput_KeyDown"/>

                    <!-- Send button -->
                    <Button Grid.Column="2"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Foreground="{StaticResource EpyksAccentBrush}"
                            ToolTipService.ToolTip="Send"
                            Click="SendBtn_Click">
                        <FontIcon Glyph="&#xE724;" FontSize="16" Foreground="{StaticResource EpyksAccentBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ====================================================
             COL 3 — MEMBER LIST (togglable)
             ==================================================== -->
        <Border Grid.Column="3" Background="#2B2D31">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="MemberListPanel" Padding="8,16" Spacing="2"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
