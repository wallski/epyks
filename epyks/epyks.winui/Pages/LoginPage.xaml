<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="epyks_winui.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:epyks_winui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="FadeInStory">
            <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C1F"/>
            <Setter Property="Foreground" Value="#E8E9EA"/>
            <Setter Property="BorderBrush" Value="#2D3035"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="CleanPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1A1C1F"/>
            <Setter Property="Foreground" Value="#E8E9EA"/>
            <Setter Property="BorderBrush" Value="#2D3035"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="PasswordRevealMode" Value="Hidden"/>
        </Style>
    </Page.Resources>

    <Grid Background="#111214">
        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.6" RadiusY="0.5">
                    <GradientStop Color="#0F1340" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border x:Name="LoginCard" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="10" Padding="36,32" Opacity="0"
                Background="#17181B" BorderBrush="#2D3035" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="24"/>
            </Border.RenderTransform>
            <Border.Shadow><ThemeShadow/></Border.Shadow>

            <StackPanel Spacing="0">

                <!-- Wordmark -->
                <TextBlock Text="EPYKS" FontSize="22" FontWeight="Bold"
                           Foreground="#E8E9EA" HorizontalAlignment="Center"
                           CharacterSpacing="400" FontFamily="Segoe UI Variable Display"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="SubtitleText" Text="Welcome back."
                           FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Tab indicators -->
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LoginTabIndicator" Grid.Column="0"
                            BorderBrush="#5865F2" BorderThickness="0,0,0,2">
                        <Button x:Name="LoginTabBtn" Content="Log In"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                FontSize="13" FontWeight="SemiBold" Foreground="#E8E9EA"
                                Padding="0" Click="LoginTabBtn_Click"/>
                    </Border>
                    <Border x:Name="RegisterTabIndicator" Grid.Column="1"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <Button x:Name="RegisterTabBtn" Content="Register"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"
                                Padding="0" Click="RegisterTabBtn_Click"/>
                    </Border>
                </Grid>
                <Border Height="1" Background="#2D3035" Margin="0,0,0,20"/>

                <!-- Hidden server box -->
                <TextBox x:Name="ServerBox" Text="26.79.18.226" Visibility="Collapsed"/>

                <!-- USERNAME -->
                <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold"
                           Foreground="#4B5563" CharacterSpacing="120" Margin="0,0,0,6"/>
                <TextBox x:Name="UserBox" PlaceholderText="Enter your username"
                         Style="{StaticResource CleanTextBoxStyle}" Margin="0,0,0,16"/>

                <!-- PASSWORD -->
                <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                           Foreground="#4B5563" CharacterSpacing="120" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PassBox" PlaceholderText="Enter your password"
                             Style="{StaticResource CleanPasswordBoxStyle}"
                             Margin="0,0,0,16" KeyDown="PassBox_KeyDown"/>

                <!-- CONFIRM PASSWORD (register only) -->
                <TextBlock x:Name="ConfirmLabel" Text="CONFIRM PASSWORD"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#4B5563" CharacterSpacing="120"
                           Margin="0,0,0,6" Visibility="Collapsed"/>
                <PasswordBox x:Name="ConfirmPassBox" PlaceholderText="Confirm your password"
                             Style="{StaticResource CleanPasswordBoxStyle}"
                             Margin="0,0,0,16" Visibility="Collapsed"/>

                <!-- Remember Me -->
                <CheckBox x:Name="RememberMeCheck" Content="Remember me"
                          IsChecked="True" Foreground="#6B7280"
                          FontSize="13" Margin="0,0,0,16"/>

                <!-- Status text -->
                <TextBlock x:Name="ErrorText" Foreground="#F23F43"
                           FontSize="13" Margin="0,0,0,12"
                           Visibility="Collapsed" TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

                <!-- CTA -->
                <Button x:Name="ActionButton" Content="Log In"
                        HorizontalAlignment="Stretch" Height="44"
                        FontSize="14" FontWeight="SemiBold"
                        Background="#5865F2" Foreground="White"
                        BorderThickness="0" CornerRadius="6"
                        Click="ActionButton_Click"/>

                <!-- Loading -->
                <ProgressRing x:Name="LoadingRing" IsActive="False"
                              Width="24" Height="24" HorizontalAlignment="Center"
                              Margin="0,14,0,0" Foreground="#5865F2"
                              Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
